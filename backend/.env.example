# Azure Storage Connection String
# Get this from Azure Portal → Storage Account → Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_storage_account;AccountKey=your_key;EndpointSuffix=core.windows.net

# Azure SQL Database Connection String
# Format: mssql+pymssql://username:password@server.database.windows.net/database
AZURE_SQL_CONNECTION_STRING=mssql+pymssql://your_user:your_password@your_server.database.windows.net/your_database

# Blob Storage Container Name
CONTAINER_NAME=presentations

# Environment: development or production
ENVIRONMENT=development

# CORS Allowed Origins (comma-separated, no spaces)
# For development, leave empty to use defaults
# For production, set to your frontend domain
CORS_ALLOWED_ORIGINS=
